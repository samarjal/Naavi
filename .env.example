# Copy this file to .env before running the app.

# Phase 1: SQLite, zero setup, file lives in prisma/dev.db
DATABASE_URL="file:./dev.db"

# Phase 2: any long random string works for local dev.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Phase 4: get a free key (no credit card) from https://aistudio.google.com/apikey
# (llmService.ts is the only file that reads this — swap providers there
# without touching any route or page)
LLM_API_KEY="replace-with-your-gemini-api-key"
LLM_MODEL="gemini-3.6-flash"

# Phase 5: get a free key at https://opentripmap.io/product
# (placesService.ts is the only file that reads this)
OPENTRIPMAP_API_KEY="replace-with-your-opentripmap-api-key"

# Added in later phases — leave blank for now:
# OPENTRIPMAP_API_KEY=
